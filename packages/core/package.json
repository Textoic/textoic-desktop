{
  "name": "@textoic/core",
  "version": "0.1.0",
  "description": "Textoic engine: sessions, audit log, providers, context engine, style lint, templates, research and fact-checking.",
  "type": "module",
  "files": ["dist", "assets"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx/esm test/**/*.test.ts"
  },
  "dependencies": {
    "budget-researcher": "link:../../../deepresearch",
    "diff": "9.0.0",
    "english-lint": "link:../../../english-lint",
    "mammoth": "1.12.2",
    "nlp": "link:../../../nlp",
    "turndown": "7.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/diff": "8.0.0",
    "@types/node": "22.18.1",
    "@types/turndown": "5.0.6",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
}
